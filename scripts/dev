#!/usr/bin/env sh
set -eu

# Contributor-friendly "one command" dev runner.
# Keeps Corepack cache local to the repo to avoid global permission issues.

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$REPO_ROOT"

# Ensure corepack uses a repo-local cache.
COREPACK_HOME="$REPO_ROOT/.corepack"
export COREPACK_HOME

# Enable corepack (Node 20+ ships it).
if command -v corepack >/dev/null 2>&1; then
  corepack enable >/dev/null 2>&1 || true
fi

# Load local env if present (gitignored).
# This is used for optional features (e.g. SDK API keys) without requiring users
# to export env vars manually.
ENV_LOCAL="$REPO_ROOT/.env.local"
if [ -f "$ENV_LOCAL" ]; then
  # shellcheck disable=SC1090
  . "$ENV_LOCAL"
fi

# Prompt for Anthropic API key if not set (optional).
# Users can press Enter to skip; the app should handle missing keys gracefully.
if [ "${ANTHROPIC_API_KEY:-}" = "" ]; then
  printf "%s" "[agents_fleet] Optional: enter ANTHROPIC_API_KEY (press Enter to skip): "
  # Read from TTY if possible; otherwise fall back to stdin.
  if [ -r /dev/tty ]; then
    read -r key </dev/tty || key=""
  else
    read -r key || key=""
  fi
  if [ "$key" != "" ]; then
    # Write to .env.local with restrictive permissions.
    umask 077
    {
      echo "# Local-only environment variables for Agents Fleet (do not commit)"
      echo "export ANTHROPIC_API_KEY=\"$key\""
    } >"$ENV_LOCAL"
    echo "[agents_fleet] Saved ANTHROPIC_API_KEY to .env.local"
    # Export for this run.
    export ANTHROPIC_API_KEY="$key"
  else
    echo "[agents_fleet] Skipping ANTHROPIC_API_KEY setup"
  fi
fi

# Install deps if needed.
if [ ! -d "$REPO_ROOT/node_modules" ]; then
  echo "[agents_fleet] Installing dependencies (pnpm install)..."
  pnpm install
fi

# -- Headroom proxy (optional) -------------------------------------------------
HEADROOM_PORT="${HEADROOM_PORT:-8787}"
HEADROOM_PID=""

# HuggingFace caches models at ~/.cache/huggingface/hub/models--<org>--<name>
HF_CACHE_DIR="${HF_HOME:-${HOME}/.cache/huggingface}/hub"
KOMPRESS_CACHE="$HF_CACHE_DIR/models--chopratejas--kompress-v2-base"

ensure_kompress_model() {
  if [ -d "$KOMPRESS_CACHE" ]; then
    echo "[agents_fleet] kompress-v2-base model already cached -- enabling HF_HUB_OFFLINE"
    export HF_HUB_OFFLINE=1
    return
  fi

  echo "[agents_fleet] kompress-v2-base model not found in cache -- downloading from HuggingFace (one-time, ~260MB)..."
  # The proxy itself only loads Kompress lazily on the first compressible
  # request (it never eager-loads at startup), so without this step the
  # model would silently never download until real traffic happened to
  # trigger it. Fetch it directly via headroom's own loader so it's ready
  # before the proxy starts.
  if "$REPO_ROOT/.venv/bin/python" -c "
from headroom.transforms.kompress_compressor import _load_kompress
_load_kompress(allow_download=True)
" >/dev/null 2>&1; then
    echo "[agents_fleet] kompress-v2-base model downloaded and cached."
    export HF_HUB_OFFLINE=1
  else
    echo "[agents_fleet] WARNING: could not pre-download kompress-v2-base model; it will be fetched lazily on first compressible request instead."
  fi
}

launch_headroom() {
  # Kill any existing process on the headroom port before starting.
  local existing_pid
  existing_pid=$(lsof -ti :"$HEADROOM_PORT" 2>/dev/null || true)
  if [ -n "$existing_pid" ]; then
    echo "[agents_fleet] Stopping existing process on port $HEADROOM_PORT (pid $existing_pid)..."
    kill "$existing_pid" 2>/dev/null || true
    sleep 1
  fi

  mkdir -p "$REPO_ROOT/data/headroom"

  # Install torch if missing (uses pip cache after first run — fast no-op on repeat)
  local VENV_PIP_CMD="$REPO_ROOT/.venv/bin/pip"
  if [ -f "$VENV_PIP_CMD" ] && ! "$REPO_ROOT/.venv/bin/python" -c "import torch" >/dev/null 2>&1; then
    echo "[agents_fleet] Installing torch for ML compression (cached after first run)..."
    "$VENV_PIP_CMD" install torch
  fi

  if [ -z "${LITELLM_BASE_URL:-}" ]; then
    echo "[agents_fleet] WARNING: LITELLM_BASE_URL is not set -- headroom will call external endpoints directly"
  else
    echo "[agents_fleet] Routing headroom -> LiteLLM at $LITELLM_BASE_URL"
  fi
  echo "[agents_fleet] Starting headroom proxy on port $HEADROOM_PORT..."
  HEADROOM_TELEMETRY=off \
  TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
  TOKENIZERS_PARALLELISM=false \
  OPENAI_TARGET_API_URL="${LITELLM_BASE_URL:-}" \
  OPENAI_API_KEY="${LITELLM_API_KEY:-}" \
  "${HEADROOM_CMD:-headroom}" proxy --port "$HEADROOM_PORT" --no-telemetry \
    --memory \
    --memory-db-path "$REPO_ROOT/data/headroom/memory.db" \
    --log-file "$REPO_ROOT/data/headroom-requests.jsonl" \
  >"$REPO_ROOT/data/headroom.log" 2>&1 &
  HEADROOM_PID=$!

  echo "[agents_fleet] Waiting for headroom proxy to be ready (first run downloads the model, may take a minute)..."
  WAIT=0
  until curl -sf "http://localhost:$HEADROOM_PORT/health" >/dev/null 2>&1; do
    if ! kill -0 "$HEADROOM_PID" 2>/dev/null; then
      echo "[agents_fleet] ERROR: headroom proxy exited unexpectedly. Logs:"
      cat "$REPO_ROOT/data/headroom.log"
      HEADROOM_PID=""
      return 1
    fi
    sleep 2
    WAIT=$((WAIT + 2))
    printf "\r[agents_fleet] Still waiting... ${WAIT}s elapsed"
  done
  echo ""
  echo "[agents_fleet] Headroom proxy ready (pid $HEADROOM_PID)"
}

start_headroom() {
  # Prefer .venv for isolation, but fall back to system headroom
  export HEADROOM_CMD=""

  # If .venv exists with headroom, use it
  if [ -f "$REPO_ROOT/.venv/bin/headroom" ]; then
    export HEADROOM_CMD="$REPO_ROOT/.venv/bin/headroom"
    ensure_kompress_model
    launch_headroom
    return
  fi

  # If .venv doesn't exist but we want to set it up, prompt for install
  if [ ! -d "$REPO_ROOT/.venv" ] || [ ! -f "$REPO_ROOT/.venv/bin/pip" ]; then
    printf "%s" "[agents_fleet] headroom not found. Install it now? [Y/n]: "
    if [ -r /dev/tty ]; then
      read -r answer </dev/tty || answer="n"
    else
      read -r answer || answer="n"
    fi
    case "$answer" in
      [nN]*) echo "[agents_fleet] Skipping headroom setup" ;;
      *)
        # Find Python 3 - prefer 3.13 or 3.10 for headroom-ai compatibility
        PYTHON_CMD=""
        for PY_CMD in python3.13 python3.10 python3 python; do
          if command -v "$PY_CMD" >/dev/null 2>&1; then
            PYTHON_CMD="$PY_CMD"
            break
          fi
        done

        if [ -z "$PYTHON_CMD" ]; then
          echo "[agents_fleet] ERROR: python3 not found"
          echo "[agents_fleet] Install Python 3.10 or 3.13: https://www.python.org/downloads/"
          echo "[agents_fleet] Skipping headroom setup"
          return
        fi

        # Check Python version
        PYTHON_VERSION=$("$PYTHON_CMD" --version 2>&1 | awk '{print $2}')
        PYTHON_MAJOR=$(echo "$PYTHON_VERSION" | cut -d. -f1)
        PYTHON_MINOR=$(echo "$PYTHON_VERSION" | cut -d. -f2)

        # headroom-ai requires 3.10+ but PyO3 only supports up to 3.13
        if [ "$PYTHON_MAJOR" -lt 3 ] || ([ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -lt 10 ]); then
          echo ""
          echo "[agents_fleet] ERROR: Python version too old"
          echo "[agents_fleet] headroom-ai requires Python 3.10+, but you have $PYTHON_VERSION"
          echo "[agents_fleet] Install from: https://www.python.org/downloads/"
          echo "[agents_fleet] Skipping headroom setup"
          return
        fi

        if [ "$PYTHON_MAJOR" -gt 3 ] || ([ "$PYTHON_MAJOR" -eq 3 ] && [ "$PYTHON_MINOR" -gt 13 ]); then
          echo ""
          echo "[agents_fleet] ERROR: Python version too new"
          echo "[agents_fleet] headroom-ai requires Python 3.10-3.13 (PyO3 doesn't support $PYTHON_MAJOR.$PYTHON_MINOR yet)"
          echo "[agents_fleet] Please use Python 3.13:"
          echo "  brew install python@3.13"
          echo "  alias python3=/opt/homebrew/bin/python3.13"
          echo "[agents_fleet] Skipping headroom setup"
          return
        fi

        # Create or clean virtual environment
        if [ -d "$REPO_ROOT/.venv" ]; then
          # Check if venv was created with different Python version
          VENV_PYTHON="$REPO_ROOT/.venv/bin/python"
          if [ -f "$VENV_PYTHON" ]; then
            VENV_VERSION=$("$VENV_PYTHON" --version 2>&1 | awk '{print $2}')
            if [ "$VENV_VERSION" != "$PYTHON_VERSION" ]; then
              echo "[agents_fleet] Removing old .venv (was Python $VENV_VERSION, need $PYTHON_VERSION)..."
              rm -rf "$REPO_ROOT/.venv"
            fi
          fi
        fi

        if [ ! -d "$REPO_ROOT/.venv" ]; then
          echo "[agents_fleet] Creating Python virtual environment (.venv) with Python $PYTHON_VERSION..."
          if ! "$PYTHON_CMD" -m venv "$REPO_ROOT/.venv"; then
            echo "[agents_fleet] ERROR: Failed to create virtual environment"
            echo "[agents_fleet] Skipping headroom setup"
            return
          fi
        fi

        # Use venv's pip
        VENV_PIP="$REPO_ROOT/.venv/bin/pip"

        echo "[agents_fleet] Installing headroom dependencies from requirements.txt..."
        if "$VENV_PIP" install -r "$REPO_ROOT/requirements.txt" >/dev/null 2>&1; then
          echo "[agents_fleet] ✓ headroom dependencies installed successfully"
          # Update HEADROOM_CMD to use venv version
          HEADROOM_CMD="$REPO_ROOT/.venv/bin/headroom"
          ensure_kompress_model
          launch_headroom
        else
          echo "[agents_fleet] ERROR: pip install failed"
          echo "[agents_fleet] Attempting to use system headroom instead..."
          if command -v headroom >/dev/null 2>&1; then
            export HEADROOM_CMD="headroom"
            ensure_kompress_model
            launch_headroom
          else
            echo "[agents_fleet] Skipping headroom setup"
          fi
        fi
        ;;
    esac
  else
    # .venv exists but no headroom installed in it - try system headroom
    if command -v headroom >/dev/null 2>&1; then
      export HEADROOM_CMD="headroom"
      ensure_kompress_model
      launch_headroom
    fi
  fi
}

cleanup() {
  if [ -n "$HEADROOM_PID" ]; then
    kill "$HEADROOM_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

start_headroom

echo "[agents_fleet] Starting dev (server + web)..."
pnpm dev
